# ── Copier ce fichier en .env et renseigner chaque variable ──────────────
# Ne jamais committer le fichier .env réel dans Git.

# ── Base de données (Neon – phase pilote) ─────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/qhse?sslmode=require

# ── JWT – générer avec : openssl rand -base64 48 ─────────────────────────
JWT_SECRET=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_48_CHARS_MINIMUM

# ── Origine autorisée pour le CORS (URL publique du frontend) ────────────
FRONTEND_ORIGIN=https://votre-domaine.exemple.fr

# ── (Si PostgreSQL local) Mot de passe du conteneur db ───────────────────
# POSTGRES_PASSWORD=MOT_DE_PASSE_SECURISE
